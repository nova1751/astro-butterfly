{
  "name": "astro-butterfly",
  "version": "0.1.0",
  "description": "A Butterfly-style blog theme for Astro — static, fast, accessible, with Hexo migration tooling.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "butterfly",
    "hexo",
    "withastro"
  ],
  "scripts": {
    "dev": "node scripts/build-font.mjs && astro dev",
    "build": "node scripts/build-font.mjs && node scripts/build-site.mjs && pagefind --site dist",
    "preview": "astro preview",
    "check": "node scripts/build-font.mjs && astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "new": "node scripts/new-post.mjs",
    "migrate:tags": "node scripts/migrate-tags.mjs",
    "build:font": "node scripts/build-font.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@expressive-code/plugin-collapsible-sections": "0.44.3",
    "@expressive-code/plugin-line-numbers": "0.44.3",
    "@shikijs/colorized-brackets": "4.6.0",
    "aplayer": "1.10.1",
    "astro": "7.4.7",
    "astro-expressive-code": "0.44.3",
    "astro-icon": "1.2.0",
    "github-slugger": "2.0.0",
    "hast-util-to-string": "3.0.1",
    "hastscript": "9.0.3",
    "katex": "0.19.1",
    "lxgw-wenkai-screen-webfont": "1.7.0",
    "mdast-util-to-string": "4.0.0",
    "photoswipe": "5.4.4",
    "rehype-katex": "7.0.1",
    "remark-directive": "4.0.0",
    "remark-math": "6.0.0",
    "twikoo": "2.0.17",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@emnapi/runtime": "1.11.3",
    "@iconify-json/fa6-brands": "1.2.6",
    "@iconify-json/fa6-regular": "1.2.4",
    "@iconify-json/fa6-solid": "1.2.4",
    "@iconify/utils": "3.1.7",
    "@playwright/test": "1.65.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "mdast-util-directive": "3.2.0",
    "pagefind": "1.6.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "subset-font": "2.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher"
    ]
  }
}
