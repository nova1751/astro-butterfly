---
import { Icon } from 'astro-icon/components';
import { features } from '@/config';
---

<div id="rightside" data-rightside>
  <div class="rightside-config" id="rightside-config-hide">
    <button type="button" data-readmode title="阅读模式" aria-label="阅读模式"><Icon name="fa6-solid:book-open" /></button>
    {features.translate && <button type="button" class="translate-btn" data-translate title="切换为繁体中文" aria-label="切换为繁体中文">繁</button>}
    <button type="button" data-darkmode title="浅色和深色模式转换" aria-label="切换深色模式"><Icon name="fa6-solid:circle-half-stroke" /></button>
    <button type="button" data-hide-aside title="单栏和双栏切换" aria-label="切换侧栏"><Icon name="fa6-solid:arrows-left-right" /></button>
  </div>
  <div class="rightside-main">
    <button type="button" class="readmode-exit" data-readmode-exit title="退出阅读模式" aria-label="退出阅读模式"><Icon name="fa6-solid:right-from-bracket" /></button>
    <button type="button" data-rightside-config title="设置" aria-label="更多设置" aria-expanded="false" aria-controls="rightside-config-hide">
      <Icon name="fa6-solid:gear" class="spin" />
    </button>
    <button type="button" class="mobile-toc-btn" data-mobile-toc title="目录" aria-label="打开目录" hidden><Icon name="fa6-solid:list-ul" /></button>
    <a href="#post-comment" class="comment-btn" data-comment-btn title="直达评论" aria-label="直达评论" hidden><Icon name="fa6-solid:comments" /></a>
    <button type="button" class="go-up" data-go-up title="回到顶部" aria-label="回到顶部">
      <span class="scroll-percent" data-scroll-percent></span>
      <Icon name="fa6-solid:arrow-up" />
    </button>
  </div>
</div>

<style>
  #rightside {
    position: fixed;
    right: -48px;
    bottom: 40px;
    z-index: 100;
    opacity: 0;
    transition: all 0.5s;
  }
  :global(html.show-rightside) #rightside,
  :global(html.read-mode) #rightside {
    right: calc(18px + env(safe-area-inset-right));
    opacity: 1;
  }
  #rightside {
    bottom: calc(40px + env(safe-area-inset-bottom));
  }
  @media (max-width: 768px) {
    :global(html.show-rightside) #rightside,
    :global(html.read-mode) #rightside {
      right: calc(10px + env(safe-area-inset-right));
    }
    #rightside {
      bottom: calc(24px + env(safe-area-inset-bottom));
    }
    #rightside > div > :is(button, a) {
      width: 32px;
      height: 32px;
      margin-bottom: 4px;
      opacity: 0.92;
    }
    #rightside > div > :is(button, a) :global(svg) {
      width: 14px;
      height: 14px;
    }
  }
  #rightside :is(button, a) {
    position: relative;
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    margin-bottom: 5px;
    border-radius: 5px;
    background: var(--btn-bg);
    color: var(--btn-color);
    font-size: 16px;
    transition: background 0.3s;
  }
  #rightside :is(button, a):hover {
    background: var(--btn-hover-color);
  }
  /* the 繁/簡 glyph sits where the icons do: same box, bold, icon-sized */
  #rightside .translate-btn {
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
  }
  #rightside .translate-btn[aria-busy='true'] { cursor: progress; opacity: 0.6; }
  #rightside :global(svg) {
    width: 16px;
    height: 16px;
  }
  /* Butterfly: the hidden group slides in from the right (and back out) */
  .rightside-config {
    transform: translateX(45px);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.4s, opacity 0.4s, visibility 0s 0.4s;
  }
  :global(html.rightside-config-open) .rightside-config {
    transform: translateX(0);
    opacity: 1;
    visibility: visible;
    transition: transform 0.4s, opacity 0.4s;
  }
  .spin {
    animation: spin 2s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .readmode-exit {
    display: none !important;
  }
  :global(html.read-mode) .readmode-exit {
    display: grid !important;
  }
  /* percent and arrow share one grid cell, so either is centred on its own */
  .go-up > :global(*) {
    grid-area: 1 / 1;
  }
  .scroll-percent {
    font-size: 12px;
    line-height: 1;
  }
  .scroll-percent:empty,
  .go-up:hover .scroll-percent {
    visibility: hidden;
  }
  .go-up:has(.scroll-percent:not(:empty)):not(:hover) :global(svg) {
    visibility: hidden;
  }
  @media (min-width: 901px) {
    .mobile-toc-btn {
      display: none !important;
    }
  }
</style>
