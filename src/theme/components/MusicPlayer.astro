---
import { music } from '@/config';
---

<!-- Global floating APlayer; persists across client-side navigations so playback never stops.
     Without a playlist id only the skin below ships (still used by ::music embeds). -->
{
  music.global.id && (
    <div
      id="global-music"
      transition:persist="global-music"
      data-global-music
      data-id={music.global.id}
      data-server={music.global.server}
      data-type={music.global.type}
      data-api={music.api}
    >
      <button type="button" data-music-start aria-label="展开音乐播放器">›</button>
    </div>
  )
}

<style is:global>
  [data-music-start] {
    position: fixed;
    left: 0;
    bottom: env(safe-area-inset-bottom, 0px);
    z-index: 95;
    width: 19px;
    height: 68px;
    border: 1px solid var(--light-grey);
    border-left: 0;
    border-radius: 0 10px 0 0;
    background: var(--card-solid-bg);
    color: var(--font-color);
    box-shadow: var(--card-box-shadow);
  }
  [data-music-start]:focus-visible { outline: 2px solid var(--link-color); }


  /*
   * APlayer skin built on the theme tokens, so the player follows light/dark and
   * looks like the rest of the cards. APlayer's CSS is injected after ours, hence
   * the `:root` prefix on every rule. Width and position overrides also handle
   * the inline styles written by the library.
   */
  :root .aplayer {
    --ap-bg: var(--card-solid-bg);
    --ap-line: var(--light-grey);
    --ap-lyric-muted: #737985;
    min-width: 0;
    max-width: 100%;
    margin: 0;
    border: 1px solid var(--ap-line);
    border-radius: 10px;
    background: var(--ap-bg);
    box-shadow: none;
    color: var(--font-color);
    font-family: var(--font-family);
  }
  :root .aplayer .aplayer-pic { border-radius: 9px 0 0 0; }
  :root .aplayer:not(.aplayer-withlist) .aplayer-pic { border-radius: 9px 0 0 9px; }
  :root .aplayer .aplayer-pic .aplayer-button { background: rgba(0, 0, 0, 0.32); }
  /* Behind a cover still loading, not APlayer's inline theme colour. */
  :root #global-music.aplayer .aplayer-pic { background-color: var(--ap-line) !important; }
  :root .aplayer .aplayer-info .aplayer-music .aplayer-title { color: var(--text-highlight-color); font-size: 14px; }
  :root .aplayer .aplayer-info .aplayer-music .aplayer-author,
  :root .aplayer .aplayer-info .aplayer-controller .aplayer-time { color: var(--muted); }
  :root .aplayer.aplayer-withlist .aplayer-info { border-bottom-color: var(--ap-line); }
  :root .aplayer .aplayer-info .aplayer-controller .aplayer-bar-wrap .aplayer-bar { background: var(--light-grey); }
  :root .aplayer .aplayer-info .aplayer-controller .aplayer-bar-wrap .aplayer-bar .aplayer-loaded { background: var(--dark-grey); }
  :root .aplayer .aplayer-icon path { fill: var(--muted); }
  :root .aplayer .aplayer-icon:hover path { fill: var(--theme-color); }
  :root .aplayer .aplayer-pic .aplayer-button path { fill: #fff; }
  :root .aplayer .aplayer-info .aplayer-controller .aplayer-volume-wrap .aplayer-volume-bar-wrap .aplayer-volume-bar { background: var(--dark-grey); }
  /* APlayer paints played/thumb/volume inline from its `theme` option; follow the mode-aware token instead. */
  :root .aplayer .aplayer-info .aplayer-controller .aplayer-bar-wrap .aplayer-bar .aplayer-played,
  :root .aplayer .aplayer-info .aplayer-controller .aplayer-volume-wrap .aplayer-volume-bar-wrap .aplayer-volume-bar .aplayer-volume { background: var(--theme-color) !important; }
  :root .aplayer .aplayer-info .aplayer-controller .aplayer-bar-wrap .aplayer-bar .aplayer-played .aplayer-thumb { background: var(--theme-color) !important; }
  :root .aplayer .aplayer-info .aplayer-controller .aplayer-bar-wrap { min-width: 0; }
  :root .aplayer .aplayer-info .aplayer-controller .aplayer-time { flex: none; }
  /* Time + five icons need ~160px; in narrow players the progress bar would
     collapse to nothing. Drop the rarely used volume / order / loop buttons
     (phones use hardware volume) so the bar keeps a usable width. */
  /* A media query, not a container query: container-type on .aplayer-info
     would stop it sitting beside the floated cover, so it would drop below
     it for a moment while the fixed player opens. */
  @media (max-width: 360px) {
    :root .aplayer .aplayer-info .aplayer-controller .aplayer-volume-wrap,
    :root .aplayer .aplayer-info .aplayer-controller .aplayer-icon-order,
    :root .aplayer .aplayer-info .aplayer-controller .aplayer-icon-loop { display: none; }
  }

  :root .aplayer .aplayer-lrc { background: transparent; text-shadow: none; }
  :root .aplayer .aplayer-lrc::before,
  :root .aplayer .aplayer-lrc::after { display: none; }
  /* APlayer advances lyrics in 16px steps: keep that line height and its transforms. */
  :root .aplayer .aplayer-lrc p { font-size: 13px; color: var(--ap-lyric-muted); opacity: 1; }
  /* current line in the accent, like the played bar and the active list item */
  :root .aplayer .aplayer-lrc p.aplayer-lrc-current { color: var(--theme-color); font-weight: 600; }
  :root .aplayer {
    --ap-lyric-halo: rgba(255, 255, 255, 0.6);
    /* frosted lyric pill (fixed player) */
    --ap-glass-bg: rgba(255, 255, 255, 0.72);
    --ap-glass-solid: rgba(255, 255, 255, 0.92);
    --ap-glass-edge: rgba(255, 255, 255, 0.7);
    --ap-glass-shadow: 0 4px 16px rgba(7, 17, 27, 0.08);
  }
  :root[data-theme='dark'] .aplayer {
    --ap-lyric-muted: #929aa6;
    --ap-lyric-halo: rgba(0, 0, 0, 0.5);
    --ap-glass-bg: rgba(24, 24, 27, 0.6);
    --ap-glass-solid: rgba(24, 24, 27, 0.92);
    --ap-glass-edge: rgba(255, 255, 255, 0.1);
    --ap-glass-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  :root .music-embed.aplayer { box-sizing: border-box; width: 100%; }

  :root .aplayer .aplayer-list ol {
    scrollbar-width: thin;
    scrollbar-color: var(--sb-thumb) transparent;
    overscroll-behavior-y: contain;
  }
  /* The global playlist (hundreds of rows) starts folded away, yet APlayer reads
     the player's width while building it, which laid out every row: most of the
     cost of opening the player. Skipped until the list is opened. */
  :root #global-music .aplayer-list ol {
    content-visibility: auto;
    contain-intrinsic-block-size: auto 300px;
  }
  /* Laid out as soon as the list opens: APlayer scrolls to the current track right
     then, which does nothing while the rows are skipped. */
  :root #global-music .aplayer-list:not(.aplayer-list-hide) ol {
    content-visibility: visible;
  }

  :root .aplayer .aplayer-list ol li {
    display: flex;
    border-top-color: var(--ap-line);
    color: var(--font-color);
  }
  :root .aplayer .aplayer-list ol li:hover { background: var(--theme-soft); }
  :root .aplayer .aplayer-list ol li.aplayer-list-light { background: var(--theme-soft); }
  :root .aplayer .aplayer-list ol li.aplayer-list-light .aplayer-list-title { color: var(--theme-color); }
  :root .aplayer .aplayer-list ol li .aplayer-list-index,
  :root .aplayer .aplayer-list ol li .aplayer-list-author { color: var(--muted); }
  :root .aplayer .aplayer-list ol li .aplayer-list-index { flex: none; }
  :root .aplayer .aplayer-list ol li .aplayer-list-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  :root .aplayer .aplayer-list ol li .aplayer-list-author {
    flex: 0 1 auto;
    max-width: 38%;
    min-width: 0;
    margin-left: 12px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* ---- global fixed player (custom.css: tucked in at the left, revealed on hover) ---- */
  :root .aplayer.aplayer-fixed {
    --ap-fixed-width: min(400px, 100vw);
    --ap-fixed-height: 68px; /* 66px cover + the body's top and bottom borders */
    z-index: 95;
    width: var(--ap-fixed-width);
    max-width: var(--ap-fixed-width); /* APlayer's own 400px loads later */
    border: 0;
    background: transparent;
  }
  :root .aplayer.aplayer-fixed .aplayer-body {
    box-sizing: border-box;
    width: var(--ap-fixed-width) !important; /* APlayer writes a content-box width inline. */
    max-width: var(--ap-fixed-width);
    background: var(--ap-bg);
    border: 1px solid var(--ap-line);
    border-left: 0;
    border-radius: 0 10px 0 0;
    box-shadow: var(--card-box-shadow);
  }
  :root .aplayer.aplayer-fixed .aplayer-pic { border-radius: 0; }
  :root .aplayer.aplayer-fixed .aplayer-info { border-top: 0; }
  /* No animation while APlayer builds the player and collapses it (music.ts). */
  :root .aplayer.ap-init .aplayer-body,
  :root .aplayer.ap-init .aplayer-list { transition: none !important; }
  :root .aplayer.aplayer-fixed .aplayer-list {
    margin-bottom: calc(var(--ap-fixed-height) + env(safe-area-inset-bottom));
    border: 1px solid var(--ap-line);
    border-bottom: 0;
    border-radius: 0 10px 0 0;
    background: var(--ap-bg);
    /* One card with the body: same shadow, drawn above the body's (so its
       upward shadow doesn't streak across the seam) and cut off at the bottom
       edge where the body continues. */
    position: relative;
    z-index: 100;
    box-shadow: var(--card-box-shadow);
    clip-path: inset(-30px -30px 0 0);
  }
  :root[data-theme='dark'] .aplayer.aplayer-fixed .aplayer-list { box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04), var(--card-box-shadow); }
  /* A closed list has no height, and no border or shadow either: the background
     paints under a border, so anything less drew a line above the player. */
  :root .aplayer.aplayer-fixed .aplayer-list.aplayer-list-hide {
    display: block;
    max-height: 0 !important;
    border-width: 0;
    box-shadow: none;
  }
  /* Folding the player takes an open list along, one card sliding off to the left:
     same duration and easing as the body, right edges level all the way (the body
     ends with 19px showing), and the list is still open when the player comes back.
     `left`, not a transform: the body has to animate width and left on the main
     thread, and a compositor animation next to it drifts apart on real frames. */
  :root .aplayer.aplayer-fixed .aplayer-list {
    left: 0;
    transition: all 0.5s ease, left 0.3s ease, visibility 0s;
  }
  :root .aplayer.aplayer-fixed.aplayer-narrow .aplayer-list {
    display: block;
    visibility: hidden;
    left: calc(19px - var(--ap-fixed-width));
    transition: left 0.3s ease, visibility 0s 0.3s;
  }
  /* With the list open the body's top-right corner meets the list: square it. */
  :root .aplayer.aplayer-fixed:has(.aplayer-list:not(.aplayer-list-hide)):not(.aplayer-narrow) :is(.aplayer-body, .aplayer-miniswitcher) {
    border-top-right-radius: 0;
  }
  :root .aplayer.aplayer-fixed .aplayer-lrc {
    box-sizing: border-box;
    left: 50%;
    right: auto;
    bottom: calc(74px + env(safe-area-inset-bottom));
    /* A frosted pill as wide as the song's longest line (the lines scroll
       inside it, so the width only changes with the song), up to 80% of the screen. */
    width: fit-content;
    max-width: min(80vw, 960px);
    height: auto;
    margin: 0;
    padding: 6px 16px;
    border: 1px solid var(--ap-glass-edge);
    border-radius: 999px;
    background: var(--ap-glass-bg);
    /* the same recipe as the header */
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    box-shadow: var(--ap-glass-shadow);
    text-shadow: 0 1px 1px var(--ap-lyric-halo);
    transform: translateX(-50%);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Fade out on an empty (instrumental) line. The open list stays as it is: it
     stacks above the pill (100 over APlayer's 98), so it simply covers any overlap. */
  :root .aplayer.aplayer-fixed .aplayer-lrc:has(p.aplayer-lrc-current:empty) {
    opacity: 0;
    transform: translateX(-50%) translateY(8px) scale(0.95);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    :root .aplayer.aplayer-fixed .aplayer-lrc { background: var(--ap-glass-solid); }
  }
  :root .aplayer.aplayer-fixed .aplayer-lrc p {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap; /* a long line never wraps out of the 16px step */
  }
  /* Clip the animated text without opaque masks covering the translucent surface. */
  :root .aplayer.aplayer-fixed .aplayer-lrc-viewport {
    height: 16px;
    overflow: hidden;
  }
  :root .aplayer.aplayer-fixed .aplayer-miniswitcher {
    box-sizing: border-box;
    background: var(--ap-bg);
    border-left: 1px solid var(--ap-line);
    border-radius: 0 10px 0 0;
  }
  /* Folded, the player's box still spans the bottom strip of the page: taps there
     belong to the page, only the visible tab takes them. */
  :root .aplayer.aplayer-fixed.aplayer-narrow { pointer-events: none; }
  :root .aplayer.aplayer-fixed.aplayer-narrow .aplayer-body { pointer-events: auto; }
  :root .aplayer.aplayer-fixed.aplayer-narrow .aplayer-body {
    width: 85px !important; /* 66px cover + 18px switcher + 1px outside border */
    left: -66px !important; /* APlayer sets `left` inline */
    transition: width 0.3s ease, left 0.3s ease;
  }
  @media (hover: hover) {
    :root .aplayer.aplayer-fixed.aplayer-narrow .aplayer-body:hover {
      left: 0 !important;
    }
  }
  :root .aplayer.aplayer-fixed.aplayer-narrow .aplayer-body:has(:focus-visible) {
    left: 0 !important;
  }
  :root[data-theme='dark'] .aplayer.aplayer-fixed .aplayer-body { box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04), var(--card-box-shadow); }

  @media (max-width: 768px) {
    /* Full width on phones. Open, it covers the side buttons instead of sitting
       under them; folded it stays below: its box still spans the bottom strip. */
    :root .aplayer.aplayer-fixed { --ap-fixed-width: 100vw; }
    :root .aplayer.aplayer-fixed:not(.aplayer-narrow) { z-index: 101; }
    /* shorter embed playlists on phones (content.css reserves the same height) */
    .music-embed.aplayer .aplayer-list,
    .music-embed.aplayer .aplayer-list ol {
      max-height: 300px !important;
    }
    :root .aplayer.aplayer-fixed {
      bottom: env(safe-area-inset-bottom);
    }
    :root .aplayer.aplayer-fixed .aplayer-body {
      bottom: env(safe-area-inset-bottom);
    }
    :root .aplayer.aplayer-fixed .aplayer-lrc {
      /* Safe distance from mobile browser toolbar & safe area */
      bottom: calc(82px + env(safe-area-inset-bottom));
      /* Constrain width so it leaves safe margins from left switcher and rightside buttons */
      max-width: min(calc(100vw - 110px), 320px);
      padding: 4px 14px;
      font-size: 12px;
    }
    :root .aplayer.aplayer-fixed .aplayer-lrc p {
      font-size: 12px;
      line-height: 16px;
    }
  }
</style>
