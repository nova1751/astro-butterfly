---
import { site, footerBadges } from '@/config';
const year = new Date().getFullYear();
---

<footer id="footer">
  <div id="footer-wrap">
    <div class="copyright">&copy;{site.since} - {year} By {site.author}</div>
    <p class="badges">
      {
        footerBadges.map((b) => (
          <a href={b.href} title={b.title} target="_blank" rel="noopener">
            <img src={b.img} alt={b.title} height="20" loading="lazy" decoding="async" />
          </a>
        ))
      }
    </p>
  </div>
</footer>

<style>
  #footer {
    position: relative;
    background: transparent;
  }
  #footer-wrap {
    padding: 40px 20px;
    text-align: center;
    color: var(--font-color);
  }
  .copyright {
    font-size: 1em;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 10px;
    margin-top: 6px;
  }
  .badges a {
    display: inline-flex;
    line-height: 1;
  }
  .badges img {
    height: 20px;
    width: auto;
    vertical-align: middle;
  }
</style>
