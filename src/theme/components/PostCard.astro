---
import { Icon } from 'astro-icon/components';
import { postUrl, coverOf, categoryUrl, tagUrl, excerpt, type Post } from '@/lib/posts';
import { formatDate } from '@/lib/date';
import { optimize, imagePresets } from '@/lib/images';

interface Props {
  post: Post;
  /** cover on the right for odd items (Butterfly position: both) */
  reverse?: boolean;
  /** Above the fold on desktop: load right away instead of lazily */
  eager?: boolean;
  /** The LCP image (first card): also fetch it at high priority */
  priority?: boolean;
}
const { post, reverse = false, eager = false, priority = false } = Astro.props;
const { title, date, categories, tags } = post.data;
const url = postUrl(post);
const cover = await optimize(coverOf(post), imagePresets.card);
---

<article class="recent-post-item card">
  <a class:list={['post_cover', { right: reverse }]} href={url} tabindex="-1" aria-hidden="true">
    <img
      class="post-bg"
      src={cover.src}
      srcset={cover.srcset}
      sizes={cover.sizes}
      alt=""
      loading={eager || priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      width="520"
      height="252"
    />
  </a>
  <div class="recent-post-info">
    <h2 class="article-title"><a href={url}>{title}</a></h2>
    <div class="article-meta-wrap">
      <span class="meta-item">
        <Icon name="fa6-regular:calendar" />
        <span class="article-meta-label">发表于</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </span>
      {
        categories.length > 0 && (
          <span class="meta-item">
            <Icon name="fa6-solid:inbox" />
            {categories.map((c, i) => (
              <>
                {i > 0 && <Icon name="fa6-solid:angle-right" class="sep" />}
                <a href={categoryUrl(categories.slice(0, i + 1))}>{c}</a>
              </>
            ))}
          </span>
        )
      }
      {
        tags.length > 0 && (
          <span class="meta-item">
            <Icon name="fa6-solid:tag" />
            {tags.map((t, i) => (
              <>
                {i > 0 && <span class="article-meta-link">•</span>}
                <a href={tagUrl(t)}>{t}</a>
              </>
            ))}
          </span>
        )
      }
    </div>
    <p class="content">{excerpt(post)}</p>
  </div>
</article>

<style>
  .recent-post-item {
    display: flex;
    align-items: center;
    height: 16.8em;
    overflow: hidden;
    margin-top: 20px;
  }
  .recent-post-item:first-child {
    margin-top: 0;
  }
  .post_cover {
    flex: none;
    width: 42%;
    height: 100%;
    overflow: hidden;
  }
  .post_cover.right {
    order: 1;
  }
  .post-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }
  .recent-post-item:hover .post-bg {
    transform: scale(1.1);
  }
  .recent-post-info {
    flex: 1;
    min-width: 0;
    padding: 0 40px;
  }
  .article-title {
    margin: 0;
    font-size: 1.55em;
    font-weight: 400;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .article-title a {
    color: var(--text-highlight-color);
  }
  .article-title a:hover {
    color: var(--theme-color);
  }
  .article-meta-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 0;
    margin: 6px 0;
    font-size: 0.9em;
    color: var(--muted);
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 4px;
  }
  .meta-item + .meta-item::before {
    content: '|';
    margin: 0 8px;
    opacity: 0.6;
  }
  .meta-item :global(svg) {
    width: 0.95em;
    height: 0.95em;
  }
  .meta-item :global(.sep) {
    width: 0.7em;
  }
  .article-meta-wrap a {
    color: var(--muted);
  }
  .article-meta-wrap a:hover {
    color: var(--theme-color);
    text-decoration: underline;
  }
  .content {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }
  @media (max-width: 768px) {
    .recent-post-item {
      flex-direction: column;
      height: auto;
    }
    .post_cover {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
    .post_cover.right {
      order: 0;
    }
    .recent-post-info {
      width: 100%;
      padding: 16px 18px 20px;
    }
    .article-title {
      font-size: 1.3em;
    }
    .article-meta-wrap {
      gap: 2px 14px;
      font-size: 0.85em;
    }
    .meta-item + .meta-item::before {
      display: none;
    }
    .recent-post-item {
      margin-top: 16px;
    }
  }
</style>
