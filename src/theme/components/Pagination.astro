---
import { Icon } from 'astro-icon/components';
import { pageUrl } from '@/lib/posts';

interface Props {
  base: string;
  current: number;
  total: number;
}
const { base, current, total } = Astro.props;

// Hexo paginator: first, last, current ±2, with … gaps
const pages: (number | '…')[] = [];
for (let i = 1; i <= total; i++) {
  if (i === 1 || i === total || Math.abs(i - current) <= 2) pages.push(i);
  else if (pages[pages.length - 1] !== '…') pages.push('…');
}
---

{
  total > 1 && (
    <nav id="pagination" aria-label="分页">
      {current > 1 && (
        <a class="extend prev" rel="prev" href={pageUrl(base, current - 1)} aria-label="上一页">
          <Icon name="fa6-solid:chevron-left" />
        </a>
      )}
      {pages.map((p) =>
        p === '…' ? (
          <span class="space">…</span>
        ) : p === current ? (
          <span class="page-number current" aria-current="page">{p}</span>
        ) : (
          <a class="page-number" href={pageUrl(base, p)}>{p}</a>
        ),
      )}
      {current < total && (
        <a class="extend next" rel="next" href={pageUrl(base, current + 1)} aria-label="下一页">
          <Icon name="fa6-solid:chevron-right" />
        </a>
      )}
    </nav>
  )
}

<style>
  #pagination {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
  }
  #pagination :is(a, span) {
    display: inline-grid;
    place-items: center;
    min-width: 2.5em;
    height: 2.5em;
    padding: 0 6px;
    border-radius: 6px;
    background: var(--card-bg);
    box-shadow: var(--card-box-shadow);
    transition: all 0.2s;
  }
  #pagination a:hover {
    background: var(--theme-hover);
    color: #fff;
  }
  #pagination .current {
    background: var(--theme-color);
    color: #fff;
  }
  #pagination .space {
    background: none;
    box-shadow: none;
  }
  #pagination :global(svg) {
    width: 0.9em;
    height: 0.9em;
  }
</style>
