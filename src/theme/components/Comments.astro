---
import { Icon } from 'astro-icon/components';
import { comments } from '@/config';

interface Props {
  /** Twikoo path — must match the Hexo-era path so existing comments stay attached */
  path: string;
}
const { path } = Astro.props;
---

{
  comments.twikoo.envId && (
<section id="post-comment" aria-labelledby="comment-headline">
  <h2 class="comment-headline" id="comment-headline">
    <Icon name="fa6-solid:comments" />
    <span>评论</span>
  </h2>
  <div id="twikoo" data-comment-box data-env-id={comments.twikoo.envId} data-path={path}>
    <p class="comment-loading">评论加载中…</p>
  </div>
</section>
  )
}

<style>
  #post-comment {
    margin-top: 40px;
  }
  .comment-headline {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    font-size: 1.43em;
    font-weight: 400;
    color: var(--font-color);
  }
  .comment-headline :global(svg) {
    width: 1em;
    height: 1em;
  }
  .comment-loading {
    padding: 30px 0;
    text-align: center;
    color: var(--muted);
  }
  /* Twikoo theming to match the card look */
  #twikoo :global(.tk-submit) {
    margin-top: 0;
  }
  #twikoo :global(.el-button--primary) {
    border-color: var(--theme-color);
    background-color: var(--theme-color);
  }
  #twikoo :global(.tk-comments-title) {
    color: var(--font-color);
  }
</style>
