---
import { Icon } from 'astro-icon/components';
import { categoryUrl, type Post } from '@/lib/posts';
import { formatDate, formatDateTime } from '@/lib/date';
import { formatCount } from '@/lib/wordcount';
import { features } from '@/config';

interface Props {
  post: Post;
  words: number;
  minutes: number;
}
const { post, words, minutes } = Astro.props;
const { title, date, updated, categories } = post.data;
---

<h1 class="post-title">{title}</h1>
<div id="post-meta">
  <div class="meta-firstline">
    <span class="post-meta-date" title={`发表于 ${formatDateTime(date)}`}>
      <Icon name="fa6-regular:calendar-days" />
      <span class="label">发表于</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </span>
    <span class="sep">|</span>
    <span class="post-meta-date" title={`更新于 ${formatDateTime(updated)}`}>
      <Icon name="fa6-solid:clock-rotate-left" />
      <span class="label">更新于</span>
      <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
    </span>
    {
      categories.length > 0 && (
        <>
          <span class="sep">|</span>
          <span class="post-meta-categories">
            <Icon name="fa6-solid:inbox" />
            {categories.map((c, i) => (
              <>
                {i > 0 && <Icon name="fa6-solid:angle-right" class="angle" />}
                <a href={categoryUrl(categories.slice(0, i + 1))}>{c}</a>
              </>
            ))}
          </span>
        </>
      )
    }
  </div>
  <div class="meta-secondline">
    <span>
      <Icon name="fa6-regular:file-word" />
      <span class="label">字数总计:</span>
      <span>{formatCount(words)}</span>
    </span>
    <span class="sep">|</span>
    <span>
      <Icon name="fa6-regular:clock" />
      <span class="label">阅读时长:</span>
      <span>{minutes}分钟</span>
    </span>
    {
      features.busuanzi && (
        <>
          <span class="sep">|</span>
          <span>
            <Icon name="fa6-regular:eye" />
            <span class="label">阅读量:</span>
            <span data-bsz="page_pv" aria-busy="true">…</span>
          </span>
        </>
      )
    }
  </div>
</div>

<style>
  .post-title {
    margin-bottom: 8px;
    font-size: 2.5em;
    font-weight: 400;
    line-height: 1.5;
    color: var(--white);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.15);
  }
  #post-meta {
    font-size: 95%;
    color: var(--white);
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.2);
  }
  #post-meta > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0 4px;
  }
  #post-meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  #post-meta :global(svg) {
    width: 0.95em;
    height: 0.95em;
  }
  #post-meta :global(.angle) {
    width: 0.7em;
  }
  #post-meta a {
    color: var(--white);
  }
  #post-meta a:hover {
    color: var(--theme-color);
  }
  .sep {
    margin: 0 4px;
  }
  @media (max-width: 768px) {
    .post-title {
      font-size: 1.6em;
      -webkit-line-clamp: 3;
    }
    #post-meta {
      font-size: 0.85em;
    }
    #post-meta > div {
      justify-content: flex-start;
    }
    #post-meta .label {
      display: none;
    }
  }
</style>
