---
import { url } from '@/lib/url';
import Layout from '../Layout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import type { Post } from '@/lib/posts';

interface Props {
  page: { page: number; total: number; items: Post[] };
}
const { page } = Astro.props;
---

<Layout header="home" title={page.page > 1 ? `第 ${page.page} 页` : undefined}>
  <h1 class="sr-only">文章列表</h1>
  <div id="recent-posts">
    {page.items.map((post, i) => <PostCard post={post} reverse={i % 2 === 1} eager={i < 2} priority={i === 0} />)}
  </div>
  <Pagination base={url('/')} current={page.page} total={page.total} />
</Layout>
