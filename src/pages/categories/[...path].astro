---
import type { GetStaticPaths } from 'astro';
import Layout from '@/theme/Layout.astro';
import ArticleSort from '@/theme/components/ArticleSort.astro';
import Pagination from '@/theme/components/Pagination.astro';
import { getCategories, paginate } from '@/lib/posts';
import { pagination } from '@/config';

export const getStaticPaths = (async () => {
  return (await getCategories()).flatMap((cat) =>
    paginate(cat.posts, pagination.list).map((p) => ({
      params: { path: p.page > 1 ? `${cat.slug}/page/${p.page}` : cat.slug },
      props: { cat, ...p },
    })),
  );
}) satisfies GetStaticPaths;

const { cat, page, total, items } = Astro.props;
---

<Layout title={`分类: ${cat.name}`} header="page">
  <div class="card page-card">
    <ArticleSort title={`分类 - ${cat.path.join(' / ')}`} count={cat.posts.length} posts={items} />
    <Pagination base={cat.url} current={page} total={total} />
  </div>
</Layout>
