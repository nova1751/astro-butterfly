---
import { Icon } from 'astro-icon/components';
import Layout from '@/theme/Layout.astro';
import { getCategories } from '@/lib/posts';

const cats = (await getCategories()).sort((a, b) => b.posts.length - a.posts.length || a.name.localeCompare(b.name));
const roots = cats.filter((c) => c.path.length === 1);
const childrenOf = (key: string) => cats.filter((c) => c.path.length > 1 && c.slug.startsWith(`${key}/`) && c.slug.split('/').length === key.split('/').length + 1);
---

<Layout title="分类" header="page">
  <div class="card page-card">
    <h1 class="category-title">分类 - {roots.length}</h1>
    <ul class="category-list">
      {
        roots.map((c) => (
          <li>
            <a class="category-link" href={c.url}>
              <Icon name="fa6-regular:folder-open" class="category-icon" />
              <span class="category-name">{c.name}</span>
              <span class="category-count" aria-label={`${c.posts.length} 篇`}>{c.posts.length}</span>
            </a>
            {childrenOf(c.slug).length > 0 && (
              <ul class="category-list-child">
                {childrenOf(c.slug).map((s) => (
                  <li>
                    <a class="category-link" href={s.url}>
                      <span class="category-name">{s.name}</span>
                      <span class="category-count" aria-label={`${s.posts.length} 篇`}>{s.posts.length}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<style>
  .category-title {
    margin: 0 0 20px;
    text-align: center;
    font-size: 2.57em;
    font-weight: 400;
    line-height: 1.5;
    color: var(--font-color);
  }
  .category-list,
  .category-list-child {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .category-list {
    display: grid;
    gap: 2px;
  }
  /* the whole row is the link: bigger hit area, icon/name/count share one centre line */
  .category-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 1.1em;
    line-height: 1.6;
    transition: background 0.2s, color 0.2s;
  }
  .category-link:hover {
    background: var(--theme-soft);
    color: var(--theme-color);
  }
  .category-link :global(.category-icon) {
    width: 1em;
    height: 1em;
    color: var(--theme-color);
  }
  .category-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .category-count {
    flex: none;
    min-width: 1.9em;
    padding: 0 0.5em;
    border-radius: 999px;
    background: var(--light-grey);
    color: var(--muted);
    font-size: 0.75em;
    line-height: 1.7;
    text-align: center;
    font-variant-numeric: tabular-nums;
    transition: inherit;
  }
  .category-link:hover .category-count {
    background: var(--theme-color);
    color: #fff;
  }
  .category-list-child {
    margin: 2px 0 4px calc(12px + 0.55em);
    padding-left: 14px;
    border-left: 2px solid var(--timeline-color);
  }
  .category-list-child .category-link {
    font-size: 1em;
  }
  @media (max-width: 768px) {
    .category-title {
      font-size: 2em;
    }
    .category-link {
      padding: 6px 8px;
    }
  }
</style>
