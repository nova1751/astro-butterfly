---
import type { GetStaticPaths } from 'astro';
import Layout from '@/theme/Layout.astro';
import ArticleSort from '@/theme/components/ArticleSort.astro';
import Pagination from '@/theme/components/Pagination.astro';
import { getTags, paginate } from '@/lib/posts';
import { pagination } from '@/config';

export const getStaticPaths = (async () => {
  return (await getTags()).flatMap((tag) =>
    paginate(tag.posts, pagination.list).map((p) => ({
      params: { tag: tag.slug, page: p.page > 1 ? `page/${p.page}` : undefined },
      props: { tag, ...p },
    })),
  );
}) satisfies GetStaticPaths;

const { tag, page, total, items } = Astro.props;
---

<Layout title={`标签: ${tag.name}`} header="page">
  <div class="card page-card">
    <ArticleSort title={`标签 - ${tag.name}`} count={tag.posts.length} posts={items} />
    <Pagination base={tag.url} current={page} total={total} />
  </div>
</Layout>
