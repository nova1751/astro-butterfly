---
import Layout from '@/theme/Layout.astro';
import { getTags } from '@/lib/posts';

const tags = (await getTags()).sort((a, b) => a.name.localeCompare(b.name, 'zh-CN'));
const max = Math.max(...tags.map((t) => t.posts.length));
const min = Math.min(...tags.map((t) => t.posts.length));
const scale = (n: number) => (max === min ? 0.5 : (n - min) / (max - min));
---

<Layout title="标签" header="page">
  <div class="card page-card">
    <h1 class="tag-cloud-title">标签 - {tags.length}</h1>
    <div class="tag-cloud-list">
      {
        tags.map((t) => (
          <a
            href={t.url}
            style={`font-size:${(1.2 + scale(t.posts.length) * 0.9).toFixed(2)}em;color:color-mix(in oklch, var(--theme-pink) ${Math.round(scale(t.posts.length) * 100)}%, var(--theme-color))`}
            title={`${t.name}（${t.posts.length} 篇）`}
          >
            {t.name}
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .tag-cloud-title {
    margin: 0 0 20px;
    text-align: center;
    font-size: 2.57em;
    font-weight: 400;
    line-height: 1.5;
    color: var(--font-color);
  }
  /* flex rows: tags of different sizes share a vertical centre instead of a ragged baseline */
  .tag-cloud-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 14px;
    line-height: 1.4;
  }
  .tag-cloud-list a {
    padding: 2px 4px;
    border-radius: 6px;
    transition: transform 0.3s;
  }
  .tag-cloud-list a:hover {
    color: var(--theme-color) !important;
    transform: scale(1.1);
  }
  @media (max-width: 768px) {
    .tag-cloud-title {
      font-size: 2em;
    }
  }
</style>
