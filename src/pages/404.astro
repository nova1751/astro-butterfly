---
import { url } from '@/lib/url';
import Layout from '@/theme/Layout.astro';
import { site } from '@/config';
---

<Layout title="404" header="page" aside={false} noindex>
  <div class="card error404">
    <img src={url(site.error404Img)} alt="" width="460" height="300" />
    <div class="error-info">
      <h1 class="error_title">404</h1>
      <p class="error_subtitle">Page Not Found</p>
      <a class="btn" href={url('/')}>回到主页</a>
    </div>
  </div>
</Layout>

<style>
  .error404 {
    display: flex;
    align-items: center;
    max-width: 800px;
    margin: 0 auto;
    overflow: hidden;
  }
  .error404 img {
    width: 50%;
    height: 300px;
    object-fit: cover;
  }
  .error-info {
    flex: 1;
    padding: 20px;
    text-align: center;
  }
  .error_title {
    font-size: 9em;
    line-height: 1;
  }
  .error_subtitle {
    margin: 10px 0 20px;
    font-size: 1.6em;
  }
  @media (max-width: 768px) {
    .error404 {
      flex-direction: column;
    }
    .error404 img {
      width: 100%;
      height: 200px;
    }
  }
</style>
