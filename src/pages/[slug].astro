---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Layout from '@/theme/Layout.astro';
import Comments from '@/theme/components/Comments.astro';
import Envelope from '@/theme/components/Envelope.astro';
import { site, aside } from '@/config';

export const getStaticPaths = (async () => {
  return (await getCollection('pages')).map((page) => ({ params: { slug: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
const type = page.data.type;
const isEmpty = !page.body?.trim();
const titles: Record<string, string> = { about: '关于', link: '友情链接' };
const title = titles[type ?? ''] ?? page.data.title;
---

<Layout title={title} header="page" topImg={page.data.top_img}>
  <div class="card page-card">
    {type === 'envelope' && <Envelope />}

    {
      type === 'about' && isEmpty && (
        <div class="about-card">
          <img src={site.avatar} alt={site.author} width="120" height="120" />
          <h1>{site.author}</h1>
          <p>{site.subtitle}</p>
          <a class="btn" href={aside.followMe.href} target="_blank" rel="noopener">GitHub</a>
        </div>
      )
    }

    {type === 'link' && isEmpty && <p class="empty-hint">暂无友链，欢迎在下方留言交换～</p>}

    <div id="article-container" class="article-container" data-pagefind-body={isEmpty ? undefined : ''}>
      <Content />
    </div>

    {page.data.comments && <Comments path={`/${page.id}/`} />}
  </div>
</Layout>

<style>
  .about-card {
    text-align: center;
    line-height: 1.8;
  }
  .about-card img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
  }
  .about-card h1 {
    margin-top: 10px;
    font-weight: 500;
  }
  .about-card .btn {
    margin-top: 10px;
  }
  .empty-hint {
    text-align: center;
    color: var(--muted);
  }
</style>
